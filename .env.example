# Deodes Backend — Environment Variables
# Copy to .env and customize for your environment
#
# SECURITY: Never commit .env to git. Add it to .gitignore.
# For mainnet secret keys: set them directly on the server, not in files.

# Database
DATABASE_URL=postgres://deodes:deodes_dev@localhost:5432/deodes?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# (No Stellar section: the rail was purged. Arc-only.)

# Arc (EVM) chain for hosted wallets and the auto-debit keeper. Mainnet only
# (chain 5042) — no more testnet. USDC (18 decimals) is gas.
# USDC contract has no default — see docs.arc.io/arc/references/contract-addresses.md.
# Empty values are safe: transfers fail fast with "not configured", never at boot.
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# ARC_CHAIN_ID=5042
# ARC_USDC_CONTRACT=0x...
# DeodesCircle deployment — source of truth is
# deodes-contracts/deployments.{testnet,mainnet}.json (Phase 0.5 freeze).
# Mainnet: 0x70A7CCB7b5fe856384Aab3aAF553E09A10AF14A4 (code-verified on chain 5042).
# ARC_CIRCLE_ADDRESS=0x...
# Protocol-fee treasury vault. MUST differ from KEEPER_ESCROW_ADDRESS
# (user-debit collector) — never configure the same address for both.
# ARC_TREASURY_ADDRESS=0x...

# Auto-debit keeper: pulls scheduled contributions for Auto-circle members.
# Empty escrow disables debiting (loop still ticks, debits nothing).
# Set directly on the server, never in a file for production.
# KEEPER_ESCROW_ADDRESS=0x...
# KEEPER_INTERVAL_MINUTES=15

# Google OAuth client ID (public value, also in the frontend env).
# Audience check for POST /v1/auth/google. Empty disables the endpoint.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT Keys (generated via: cd config/keys && openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem)
JWT_PRIVATE_KEY_PATH=./config/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./config/keys/jwt-public.pem

# Server
SERVER_PORT=1100
ENVIRONMENT=development

# CORS allowed origins (comma separated). Optional: when unset, the allowed
# origins are resolved per environment (development -> localhost:1110 and
# 127.0.0.1:1110, staging -> https://staging.deodes.com, production ->
# https://app.deodes.com, https://www.deodes.com and https://deodes.com).
# DEODES_CORS_ALLOWED_ORIGINS is canonical (DEODES_* accepted as legacy).
ALLOWED_ORIGINS=http://localhost:1110

# Optional: Notification providers
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=
# SMS_PROVIDER=twilio
# SMS_ACCOUNT_SID=
# SMS_AUTH_TOKEN=
